# Sitenin yayınlanacağı tam adres — sonunda "/" olmalı.
#
# Bu değer index.html içindeki canonical ve Open Graph etiketlerinde kullanılır.
# Varsayılan "./" göreli çalışır; sosyal medya önizlemesinin her platformda
# sorunsuz görünmesi için GitHub Pages adresinizi yazın, örn:
#
#   VITE_SITE_URL=https://kullanici-adiniz.github.io/gkm-landing/
#
VITE_SITE_URL=./
